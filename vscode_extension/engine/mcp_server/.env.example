# Copy this file to `.env` (same folder) and fill in your keys.
# The server reads ONLY this file: <install path>/factory_a_pkg/mcp_server/.env
# If you prefer central .env, set process env vars before launching the server
# (the loader uses setdefault, so real env vars always win).

# DeepSeek — sign up: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Kimi (Moonshot) — sign up: https://platform.moonshot.ai
MOONSHOT_API_KEY=sk-...

# Optional — override the factory_a_pkg root (default: this file's parent-of-parent)
# FACTORY_A_HOME=C:\path\to\factory_a_pkg
